
# CTAI Olymptrade Bridge Configuration
APP_NAME=CTAI-Olymptrade-Bridge
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Broker Connection
# Live connection is not implemented yet.
OLYMPTRADE_ENABLED=false

# Keep credentials empty until a verified integration is implemented.
OLYMPTRADE_SESSION=
OLYMPTRADE_API_URL=

# Market Data
MARKET_DATA_ENABLED=false
DEFAULT_TIMEFRAME=60
MAX_CANDLES_PER_REQUEST=150

# Security
# Configure a strong secret through the deployment environment
# when authentication is implemented.
API_AUTH_ENABLED=false
API_SECRET=

# Runtime
ENVIRONMENT=development
